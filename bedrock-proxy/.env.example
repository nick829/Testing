PROXY_HOST=0.0.0.0
PROXY_PORT=19132
SERVER_HOST=127.0.0.1
SERVER_PORT=19133
PACKS_DIR=./packs
LOG_LEVEL=info
RAKNET_BACKEND=jsp-raknet

# Optional. Omit to use the bedrock-protocol default version.
BEDROCK_VERSION=

# Keep the admin dashboard on loopback unless a token is configured.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_TOKEN=

# Comma-separated IPs allowed to connect to the relay.
CLIENT_ALLOWLIST=127.0.0.1,::1